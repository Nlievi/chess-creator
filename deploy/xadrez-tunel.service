# Cloudflare Quick Tunnel do Xadrez IA: publica http://localhost:3000 numa URL https://….trycloudflare.com
# A URL muda a cada início. Para ver a atual: bash /opt/xadrez-ia/deploy/tunel.sh
# Parar (incidente "cloudflared encerrado"): sudo systemctl stop xadrez-tunel
[Unit]
Description=Cloudflare Quick Tunnel do Xadrez IA
After=network-online.target xadrez.service
Wants=network-online.target

[Service]
Type=simple
User=xadrez
ExecStart=/usr/bin/env cloudflared tunnel --no-autoupdate --url http://localhost:3000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
