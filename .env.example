# Copie para .env e ajuste. O .env NUNCA vai para o Git.

# Porta e endereço onde o jogo escuta
PORT=3000
# 0.0.0.0 = aceita conexões de qualquer rede | 127.0.0.1 = só da própria máquina
HOST=0.0.0.0

# IA (Cloudflare Workers AI, cota gratuita diária). Sem estas linhas o jogo usa o modo "simulado".
# Painel do Cloudflare -> AI -> Workers AI -> "Use REST API" (gera o token e mostra o Account ID)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_MODELO=@cf/black-forest-labs/flux-2-klein-4b
# IA_PROVEDOR=simulado

# Quantas peças cada pessoa pode gerar por hora
IA_LIMITE_POR_HORA=20
