# Copie para .env e ajuste. O .env NUNCA vai para o Git.
# Depois de mudar este arquivo: sudo systemctl restart xadrez

# Porta e endereço onde o jogo escuta
PORT=3000
# 0.0.0.0 = aceita conexões de qualquer rede | 127.0.0.1 = só da própria máquina (o túnel continua funcionando)
HOST=0.0.0.0

# IA (Cloudflare Workers AI, cota gratuita diária). Sem estas linhas o modo "Foto de pessoa" fica desativado.
# Painel do Cloudflare -> AI -> Workers AI -> "Use REST API" (gera o token e mostra o Account ID)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_MODELO=@cf/black-forest-labs/flux-2-klein-4b

# Limites da IA: por pessoa, por hora; e o total do servidor por dia (protege a cota gratuita)
IA_LIMITE_POR_HORA=40
IA_LIMITE_DIA=300

# Máximo de peças personalizadas guardadas em data/pecas (para ninguém encher o disco pela URL pública)
PECAS_MAXIMO=3000
